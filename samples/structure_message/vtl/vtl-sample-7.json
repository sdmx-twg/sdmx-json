		"rulesetSchemes": [
			{
				"id": "RS_POP",
				"version": "1.0",
				"agencyID": "EXAMPLE",
				"name": "Rulesets for the population data",
				"names": {
					"en": "Rulesets for the population data"
				},
				"vtlVersion": "2.2",
				"rulesets": [
					{
						"id": "DPR_VALUE",
						"name": "Consistency of the observation values",
						"names": {
							"en": "Consistency of the observation values"
						},
						"rulesetType": "datapoint",
						"rulesetScope": "variable",
						"rulesetDefinition": "define datapoint ruleset DPR_VALUE (variable OBS_VALUE as V, OBS_STATUS as S) is\n  VALUE_NOT_NEGATIVE : V >= 0 errorcode \"NEGATIVE_VALUE\" errorlevel 1;\n  MISSING_WITHOUT_VALUE : when S = \"M\" then isnull(V) errorcode \"VALUE_WITH_MISSING_STATUS\" errorlevel 2\nend datapoint ruleset"
					},
					{
						"id": "HR_BENELUX",
						"name": "Benelux aggregate",
						"names": {
							"en": "Benelux aggregate"
						},
						"rulesetType": "hierarchical",
						"rulesetScope": "valuedomain",
						"rulesetDefinition": "define hierarchical ruleset HR_BENELUX (valuedomain rule cl_area) is\n  BENELUX_TOTAL : BENELUX = BE + LU + NL errorcode \"BENELUX_NOT_SUM\" errorlevel 1\nend hierarchical ruleset"
					},
					{
						"id": "VP_OBS_STATUS",
						"name": "Viral propagation of OBS_STATUS",
						"names": {
							"en": "Viral propagation of OBS_STATUS"
						},
						"rulesetType": "viral",
						"rulesetScope": "variable",
						"rulesetDefinition": "define viral propagation VP_OBS_STATUS (variable OBS_STATUS) is\n  when \"M\" then \"M\";\n  when \"E\" then \"E\";\n  else \"A\"\nend viral propagation"
					}
				]
			}
		],
		"transformationSchemes": [
			{
				"id": "TS_POP_CHECKS",
				"version": "1.0",
				"agencyID": "EXAMPLE",
				"name": "Validation and aggregation of the population data",
				"names": {
					"en": "Validation and aggregation of the population data"
				},
				"vtlVersion": "2.2",
				"transformations": [
					{
						"id": "VALIDATION",
						"name": "Validation results",
						"names": {
							"en": "Validation results"
						},
						"description": "Applies the datapoint ruleset DPR_VALUE to ds_pop and returns, for each data point and rule (ruleid), the original measures, the boolean outcome of the rule (bool_var) and, when the rule is not satisfied, its errorcode and errorlevel. OBS_STATUS is kept, as it is a viral VTL Attribute.",
						"descriptions": {
							"en": "Applies the datapoint ruleset DPR_VALUE to ds_pop and returns, for each data point and rule (ruleid), the original measures, the boolean outcome of the rule (bool_var) and, when the rule is not satisfied, its errorcode and errorlevel. OBS_STATUS is kept, as it is a viral VTL Attribute."
						},
						"isPersistent": true,
						"expression": "check_datapoint(ds_pop, DPR_VALUE all_measures)",
						"result": "ds_validation"
					},
					{
						"id": "BENELUX",
						"name": "Benelux aggregate",
						"names": {
							"en": "Benelux aggregate"
						},
						"description": "Calculates BENELUX as BE + LU + NL through the hierarchical ruleset HR_BENELUX, applied to the Identifier REF_AREA. The values of OBS_STATUS of the components are combined through the viral propagation VP_OBS_STATUS.",
						"descriptions": {
							"en": "Calculates BENELUX as BE + LU + NL through the hierarchical ruleset HR_BENELUX, applied to the Identifier REF_AREA. The values of OBS_STATUS of the components are combined through the viral propagation VP_OBS_STATUS."
						},
						"isPersistent": true,
						"expression": "hierarchy(ds_pop, HR_BENELUX rule REF_AREA)",
						"result": "ds_benelux"
					}
				],
				"vtlMappingScheme": "urn:sdmx:org.sdmx.infomodel.transformation.VtlMappingScheme=EXAMPLE:VTL_MAP_POP(1.0)",
				"rulesetSchemes": [
					"urn:sdmx:org.sdmx.infomodel.transformation.RulesetScheme=EXAMPLE:RS_POP(1.0)"
				]
			}
