				"transformations": [
					{
						"id": "RATIO",
						"name": "Ratio between the male and the female population",
						"names": {
							"en": "Ratio between the male and the female population"
						},
						"description": "The sub clauses drop the SEX Identifier, whose value is fixed in each input by the key of its data extraction. Without them, the division would not match any data points, because VTL composes the data points having the same values for all the Identifiers. The result has the Identifiers REF_AREA, AGE and TIME_PERIOD and the Measure OBS_VALUE, as the data structure of DF_POPRATIO.",
						"descriptions": {
							"en": "The sub clauses drop the SEX Identifier, whose value is fixed in each input by the key of its data extraction. Without them, the division would not match any data points, because VTL composes the data points having the same values for all the Identifiers. The result has the Identifiers REF_AREA, AGE and TIME_PERIOD and the Measure OBS_VALUE, as the data structure of DF_POPRATIO."
						},
						"isPersistent": true,
						"expression": "pop_m [ sub SEX = \"M\" ] / pop_f [ sub SEX = \"F\" ]",
						"result": "ratio"
					}
				],
				"vtlMappingScheme": "urn:sdmx:org.sdmx.infomodel.transformation.VtlMappingScheme=SDMX:VTL_MAP_POP(1.0.0)"
			}
