		"rulesetSchemes": [
			{
				"id": "RS_X",
				"version": "1.0",
				"agencyID": "EXAMPLE",
				"name": "Viral propagations",
				"names": {
					"en": "Viral propagations"
				},
				"vtlVersion": "2.2",
				"rulesets": [
					{
						"id": "OBS_STATUS_PROP",
						"name": "Viral propagation of OBS_STATUS",
						"names": {
							"en": "Viral propagation of OBS_STATUS"
						},
						"rulesetType": "viral",
						"rulesetScope": "variable",
						"rulesetDefinition": "define viral propagation OBS_STATUS_PROP (variable OBS_STATUS) is\n  when \"M\" then \"M\";\n  when \"E\" then \"E\";\n  else \"A\"\nend viral propagation"
					}
				]
			}
		],
		"transformationSchemes": [
			{
				"id": "TS_AREACHK",
				"version": "1.0",
				"agencyID": "EXAMPLE",
				"name": "Check of the reference areas and total of two sources",
				"names": {
					"en": "Check of the reference areas and total of two sources"
				},
				"vtlVersion": "2.2",
				"transformations": [
					{
						"id": "INVALID",
						"name": "Data points with an invalid reference area",
						"names": {
							"en": "Data points with an invalid reference area"
						},
						"description": "Selects the data points of ds_x whose REF_AREA is not a value of the VTL Value Domain cl_area, i.e. not a Code of SDMX:CL_AREA(2.0).",
						"descriptions": {
							"en": "Selects the data points of ds_x whose REF_AREA is not a value of the VTL Value Domain cl_area, i.e. not a Code of SDMX:CL_AREA(2.0)."
						},
						"isPersistent": true,
						"expression": "ds_x [ filter not ( REF_AREA in cl_area ) ]",
						"result": "ds_invalid"
					},
					{
						"id": "TOTAL",
						"name": "Total of sources X and Y",
						"names": {
							"en": "Total of sources X and Y"
						},
						"description": "Adds the observations of ds_x and ds_y. OBS_STATUS is a viral VTL Attribute, because the ruleset scheme RS_X referenced by this transformation scheme contains a viral propagation for it: the + operator keeps it in the result, combining the values of the inputs through OBS_STATUS_PROP, so that the result has the data structure of DF_TOTAL. Without the viral propagation, OBS_STATUS would be a non-viral VTL Attribute and the result would not have it.",
						"descriptions": {
							"en": "Adds the observations of ds_x and ds_y. OBS_STATUS is a viral VTL Attribute, because the ruleset scheme RS_X referenced by this transformation scheme contains a viral propagation for it: the + operator keeps it in the result, combining the values of the inputs through OBS_STATUS_PROP, so that the result has the data structure of DF_TOTAL. Without the viral propagation, OBS_STATUS would be a non-viral VTL Attribute and the result would not have it."
						},
						"isPersistent": true,
						"expression": "ds_x + ds_y",
						"result": "ds_total"
					}
				],
				"vtlMappingScheme": "urn:sdmx:org.sdmx.infomodel.transformation.VtlMappingScheme=EXAMPLE:VTL_MAP_X(1.0)",
				"rulesetSchemes": [
					"urn:sdmx:org.sdmx.infomodel.transformation.RulesetScheme=EXAMPLE:RS_X(1.0)"
				]
			}
